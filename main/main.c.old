// Replacement for es8311_write_reg that uses new I2C driver
static esp_err_t es8311_write_reg_new(uint8_t reg_addr, uint8_t data) {
    if (es8311_dev_handle == NULL) {
        ESP_LOGE(TAG, "ES8311 device handle not initialized");
        return ESP_FAIL;
    }
    
    uint8_t write_buf[2] = {reg_addr, data};
    return i2c_master_transmit(es8311_dev_handle, write_buf, 2, 1000);
}

// Replacement for es8311_read_reg that uses new I2C driver
static esp_err_t es8311_read_reg_new(uint8_t reg_addr, uint8_t *reg_value) {
    if (es8311_dev_handle == NULL) {
        ESP_LOGE(TAG, "ES8311 device handle not initialized");
        return ESP_FAIL;
    }
    
    return i2c_master_transmit_receive(es8311_dev_handle, 
                                      &reg_addr, 1, 
                                      reg_value, 1, 
                                      1000);
}

// ============================
// 0. Audio power amplifier
// ============================
static void enable_power_amplifier(void) {
    ESP_LOGI(TAG, "Enabling power amplifier on GPIO %d", PA_ENABLE_PIN);
    
    gpio_config_t io_conf = {
        .pin_bit_mask = (1ULL << PA_ENABLE_PIN),
        .mode = GPIO_MODE_OUTPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_DISABLE,
    };
    gpio_config(&io_conf);
    gpio_set_level(PA_ENABLE_PIN, 1); // Set HIGH to enable
    vTaskDelay(pdMS_TO_TICKS(10)); // Let PA stabilize
}

// ============================
// 1. INITIALIZE PSRAM FOR AUDIO BUFFER
// ============================
static esp_err_t init_psram_buffer(void) {
    ESP_LOGI(TAG, "Allocating audio buffer...");
    
    size_t buffer_size_needed = SAMPLES_TO_REC * sizeof(int16_t);
    ESP_LOGI(TAG, "Buffer size needed: %d bytes", buffer_size_needed);
    
    // First try PSRAM
    ESP_LOGI(TAG, "Trying PSRAM allocation...");
    g_audio_buffer = (int16_t *)heap_caps_malloc(buffer_size_needed, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (g_audio_buffer == NULL) {
        ESP_LOGW(TAG, "PSRAM allocation failed. Trying SPI RAM DMA capable memory...");
        g_audio_buffer = (int16_t *)heap_caps_malloc(buffer_size_needed, MALLOC_CAP_SPIRAM | MALLOC_CAP_DMA);
    }
    
    if (g_audio_buffer == NULL) {
        ESP_LOGW(TAG, "All PSRAM attempts failed. Checking internal RAM...");
        
        // Check if we have enough internal RAM
        size_t free_internal = heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
        ESP_LOGI(TAG, "Free internal RAM: %d bytes", free_internal);
        
        if (free_internal > buffer_size_needed * 1.2) { // Need 20% extra
            ESP_LOGI(TAG, "Trying internal RAM allocation...");
            g_audio_buffer = (int16_t *)malloc(buffer_size_needed);
            
            if (g_audio_buffer == NULL) {
                ESP_LOGE(TAG, "Internal RAM allocation also failed!");
                return ESP_FAIL;
            }
            ESP_LOGI(TAG, "Using internal RAM for audio buffer.");
        } else {
            ESP_LOGE(TAG, "Not enough internal RAM. Need %d bytes, have %d bytes.", 
                     buffer_size_needed, free_internal);
            return ESP_FAIL;
        }
    } else {
        ESP_LOGI(TAG, "PSRAM allocation successful!");
    }
    
    memset(g_audio_buffer, 0, buffer_size_needed);
    ESP_LOGI(TAG, "Audio buffer allocated. Capacity: %"PRIu32" samples (%"PRIu32" seconds).",
             SAMPLES_TO_REC, REC_SECONDS_MAX);
    return ESP_OK;
}

// ============================
// 2. INITIALIZE BUTTONS & INTERRUPTS
// ============================
static esp_err_t init_buttons(void) {
    ESP_LOGI(TAG, "Initializing buttons on GPIO %d (REC) and %d (PLAY)...",
             BUTTON_REC_GPIO, BUTTON_PLAY_GPIO);

    gpio_config_t io_conf = {};
    // Bit mask for both buttons
    io_conf.pin_bit_mask = (1ULL << BUTTON_REC_GPIO) | (1ULL << BUTTON_PLAY_GPIO);
    io_conf.mode = GPIO_MODE_INPUT;
    io_conf.pull_up_en = GPIO_PULLUP_DISABLE; // Buttons likely active-low (pressed = LOW)
    io_conf.pull_down_en = GPIO_PULLDOWN_DISABLE;
    io_conf.intr_type = GPIO_INTR_NEGEDGE; // Trigger interrupt on falling edge (button press)
    ESP_ERROR_CHECK(gpio_config(&io_conf));

    // Create a queue to handle button events from ISR
    g_button_event_queue = xQueueCreate(10, sizeof(button_event_t));
    if (g_button_event_queue == NULL) {
        ESP_LOGE(TAG, "Failed to create button event queue");
        return ESP_FAIL;
    }

    // Install GPIO ISR service and add handler
    ESP_ERROR_CHECK(gpio_install_isr_service(0));
    ESP_ERROR_CHECK(gpio_isr_handler_add(BUTTON_REC_GPIO, gpio_isr_handler, (void *)BUTTON_REC_EVENT));
    ESP_ERROR_CHECK(gpio_isr_handler_add(BUTTON_PLAY_GPIO, gpio_isr_handler, (void *)BUTTON_PLAY_EVENT));

    ESP_LOGI(TAG, "Buttons and interrupts initialized.");
    return ESP_OK;
}

// ============================
// GPIO INTERRUPT SERVICE ROUTINE
// ============================
static void IRAM_ATTR gpio_isr_handler(void* arg) {
    button_event_t evt = (button_event_t)arg;
    // Send event to queue (from ISR context)
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;
    xQueueSendFromISR(g_button_event_queue, &evt, &xHigherPriorityTaskWoken);
    if (xHigherPriorityTaskWoken == pdTRUE) {
        portYIELD_FROM_ISR();
    }
}


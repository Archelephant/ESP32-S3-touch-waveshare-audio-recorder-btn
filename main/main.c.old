#define MCLK_MULTIPLE       I2S_MCLK_MULTIPLE_256
#define REC_BUFFER_SIZE     1024
#define SILENCE_THRESHOLD   500   // RMS threshold to stop recording (adjust empirically)
#define SILENCE_DURATION_MS 1500  // Duration of silence before stopping (ms)

// Recording buffer in PSRAM (e.g., 10 seconds)

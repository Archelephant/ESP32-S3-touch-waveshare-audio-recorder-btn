// Separate I2C initialization for ES8311 - new
static esp_err_t init_i2c_for_es8311(void) {
    ESP_LOGI(TAG, "Initializing I2C for ES8311 with NEW master driver...");
    
    // Configuration for NEW I2C master driver
    i2c_master_bus_config_t bus_config = {
        .i2c_port = I2C_PORT_NUM,
        .sda_io_num = I2C_SDA_IO,
        .scl_io_num = I2C_SCL_IO,
        .clk_source = I2C_CLK_SRC_DEFAULT,
        .glitch_ignore_cnt = 7,
        .flags.enable_internal_pullup = true, // Enable internal pull-ups
    };
    
    esp_err_t ret = i2c_new_master_bus(&bus_config, &i2c_bus_handle);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Failed to create I2C bus: %s", esp_err_to_name(ret));
        return ret;
    }
    
    ESP_LOGI(TAG, "I2C master bus initialized on port %d", I2C_PORT_NUM);
    return ESP_OK;
}

// I2C Scanner - to check the exact configuration of pins

static void i2c_scanner(void) {
    ESP_LOGI(TAG, "Starting I2C scanner on port %d, SDA:%d, SCL:%d...",
             I2C_PORT_NUM, I2C_SDA_IO, I2C_SCL_IO);
    i2c_cmd_handle_t cmd;
    esp_err_t ret;
    uint8_t found = 0;
    
    for (uint8_t addr = 1; addr < 127; addr++) {
        cmd = i2c_cmd_link_create();
        i2c_master_start(cmd);
        i2c_master_write_byte(cmd, (addr << 1) | I2C_MASTER_WRITE, true);
        i2c_master_stop(cmd);
        
        ret = i2c_master_cmd_begin(I2C_PORT_NUM, cmd, 100 / portTICK_PERIOD_MS);
        i2c_cmd_link_delete(cmd);
        
        if (ret == ESP_OK) {
            ESP_LOGI(TAG, "Found device at address: 0x%02X", addr);
            found++;
            if (addr == ES8311_I2C_ADDR) {
                ESP_LOGI(TAG, "  ^-- This is the ES8311 target address!");
            }
        } else if (ret == ESP_ERR_TIMEOUT) {
            ESP_LOGW(TAG, "Timeout at address 0x%02X", addr);
        }
    }
    if (found == 0) {
        ESP_LOGW(TAG, "No I2C devices found. Check wiring/pull-ups.");
    } else {
        ESP_LOGI(TAG, "Scan complete. Found %d device(s).", found);
    }
}

static esp_err_t scan_i2c_devices(void) {
    ESP_LOGI(TAG, "Starting I2C bus scan...");
    uint8_t found = 0;
    
    for (uint8_t addr = 1; addr < 127; addr++) {
        i2c_device_config_t dev_cfg = {
            .dev_addr_length = I2C_ADDR_BIT_LEN_7,
            .device_address = addr,
            .scl_speed_hz = 10000,  // VERY slow - 10 kHz for detection
            .scl_wait_us = 20000,   // 20 ms timeout
        };
        
        i2c_master_dev_handle_t temp_handle;
        esp_err_t ret = i2c_master_bus_add_device(i2c_bus_handle, &dev_cfg, &temp_handle);
        
        if (ret == ESP_OK) {
            ESP_LOGI(TAG, "✓ Found I2C device at address: 0x%02X", addr);
            
            // Test if it's ES8311 by reading chip ID
            if (addr == ES8311_I2C_ADDR || addr == 0x19) {
                uint8_t chip_id;
                if (es8311_read_reg_new(0xFD, &chip_id) == ESP_OK) {
                    ESP_LOGI(TAG, "  -> Confirmed ES8311! Chip ID: 0x%02X", chip_id);
                }
            }
            
            i2c_master_bus_rm_device(temp_handle);
            found++;
            vTaskDelay(pdMS_TO_TICKS(10)); // Small delay
        }
    }
    
    if (found == 0) {
        ESP_LOGE(TAG, "✗ No I2C devices found!");
        ESP_LOGE(TAG, "Check: 1) I2C pins 2) Power 3) Pull-up resistors");
    } else {
        ESP_LOGI(TAG, "Scan complete. Found %d device(s).", found);
    }
    
    return (found > 0) ? ESP_OK : ESP_FAIL;
}

static esp_err_t try_alternative_i2c_pins(void) {
    ESP_LOGI(TAG, "Testing alternative I2C pin configurations...");
    
    // List of possible I2C pin combinations for ESP32-S3
    typedef struct {
        int port;
        int sda;
        int scl;
        const char* desc;
    } i2c_pin_test_t;
    
    i2c_pin_test_t pin_configs[] = {
        {0, 8, 9, "Default I2C0 (GPIO8/9)"},
        {0, 6, 7, "Alternate I2C0 (GPIO6/7)"},
        {1, 10, 11, "Default I2C1 (GPIO10/11) - YOUR CURRENT"},
        {1, 2, 3, "Alternate I2C1 (GPIO2/3)"},
        {0, 18, 19, "I2C0 (GPIO18/19)"},
        {1, 20, 21, "I2C1 (GPIO20/21)"},
    };
    
    for (int i = 0; i < sizeof(pin_configs)/sizeof(pin_configs[0]); i++) {
        ESP_LOGI(TAG, "Testing: %s", pin_configs[i].desc);
        
        // Temporarily create I2C bus with these pins
        i2c_master_bus_handle_t test_bus = NULL;
        i2c_master_bus_config_t bus_config = {
            .i2c_port = pin_configs[i].port,
            .sda_io_num = pin_configs[i].sda,
            .scl_io_num = pin_configs[i].scl,
            .clk_source = I2C_CLK_SRC_DEFAULT,
            .glitch_ignore_cnt = 7,
            .flags.enable_internal_pullup = true,
        };
        
        esp_err_t ret = i2c_new_master_bus(&bus_config, &test_bus);
        if (ret != ESP_OK) {
            ESP_LOGW(TAG, "  ✗ Failed to create bus");
            continue;
        }
        
        // Try to communicate with ES8311
        i2c_device_config_t dev_cfg = {
            .dev_addr_length = I2C_ADDR_BIT_LEN_7,
            .device_address = ES8311_I2C_ADDR,
            .scl_speed_hz = 10000,
            .scl_wait_us = 10000,
        };
        
        i2c_master_dev_handle_t test_dev;
        ret = i2c_master_bus_add_device(test_bus, &dev_cfg, &test_dev);
        if (ret == ESP_OK) {
            uint8_t chip_id;
            ret = i2c_master_transmit_receive(test_dev, (uint8_t[]){0xFD}, 1, &chip_id, 1, 100);
            if (ret == ESP_OK) {
                ESP_LOGI(TAG, "  ✓ SUCCESS! ES8311 found at 0x%02X, Chip ID: 0x%02X", 
                        ES8311_I2C_ADDR, chip_id);
                i2c_master_bus_rm_device(test_dev);
                i2c_del_master_bus(test_bus);
                return ESP_OK;
            }
            i2c_master_bus_rm_device(test_dev);
        }
        
        i2c_del_master_bus(test_bus);
        ESP_LOGW(TAG, "  ✗ No ES8311 response");
    }
    
    return ESP_FAIL;
}

// Helper function to check the I2C Bus status
static void check_i2c_bus_status(void) {
    ESP_LOGI(TAG, "Checking I2C bus status...");
    
    // Test I2C by writing to a dummy address and checking for ACK
    i2c_cmd_handle_t cmd = i2c_cmd_link_create();
    i2c_master_start(cmd);
    i2c_master_write_byte(cmd, (ES8311_I2C_ADDR << 1) | I2C_MASTER_WRITE, true);
    i2c_master_stop(cmd);
    
    esp_err_t ret = i2c_master_cmd_begin(I2C_PORT_NUM, cmd, 1000 / portTICK_PERIOD_MS);
    i2c_cmd_link_delete(cmd);
    
    if (ret == ESP_OK) {
        ESP_LOGI(TAG, "I2C bus seems operational. Device at 0x%02X responded.", ES8311_I2C_ADDR);
    } else if (ret == ESP_ERR_TIMEOUT) {
        ESP_LOGE(TAG, "I2C timeout - check SCL/SDA connections and pull-up resistors");
    } else if (ret == ESP_FAIL) {
        ESP_LOGE(TAG, "I2C NACK - device not responding at 0x%02X", ES8311_I2C_ADDR);
    } else {
        ESP_LOGE(TAG, "I2C error: %s (0x%x)", esp_err_to_name(ret), ret);
    }
    
    // Check GPIO configuration
    ESP_LOGI(TAG, "GPIO %d (SDA) and GPIO %d (SCL) should be configured for I2C", I2C_SDA_IO, I2C_SCL_IO);
}

// Check I2C with SDA pins
static void simple_i2c_test(void) {
    ESP_LOGI(TAG, "Simple I2C test: Toggling SDA pin...");
    
    // Configure SDA as output temporarily
    gpio_set_direction(I2C_SDA_IO, GPIO_MODE_OUTPUT);
    
    for (int i = 0; i < 5; i++) {
        gpio_set_level(I2C_SDA_IO, 1);
        vTaskDelay(pdMS_TO_TICKS(100));
        gpio_set_level(I2C_SDA_IO, 0);
        vTaskDelay(pdMS_TO_TICKS(100));
    }
    
    ESP_LOGI(TAG, "If you can see SDA toggling on scope/meter, GPIO is working");
}

// Helper: check which I2C ports are available
static void check_i2c_ports(void) {
    ESP_LOGI(TAG, "Available I2C ports on ESP32-S3:");
    ESP_LOGI(TAG, "  I2C_NUM_0: GPIO6/SCL, GPIO7/SDA (default)");
    ESP_LOGI(TAG, "  I2C_NUM_1: GPIO8/SCL, GPIO9/SDA (alternate)");
    ESP_LOGI(TAG, "  Your pins: GPIO%d/SCL, GPIO%d/SDA", I2C_SCL_IO, I2C_SDA_IO);
}


                }
            }
        }
    }
    
    if (found == 0) {
        ESP_LOGW(TAG, "No I2C devices found.");
        ESP_LOGI(TAG, "\nTROUBLESHOOTING:");
        ESP_LOGI(TAG, "1. Check SDA/SCL connections (GPIO%d/GPIO%d)", I2C_SDA_IO, I2C_SCL_IO);
        ESP_LOGI(TAG, "2. Add 4.7kΩ external pull-up resistors to 3.3V");
        ESP_LOGI(TAG, "3. Verify ES8311 is powered (3.3V and GND)");
        ESP_LOGI(TAG, "4. Check I2C address jumpers on ES8311 board");
        ESP_LOGI(TAG, "5. Try alternative I2C pins: GPIO8/9 or GPIO2/3");
    } else if (found > 20) {
        ESP_LOGW(TAG, "Found %d devices - this is suspicious!", found);
        ESP_LOGI(TAG, "Too many devices detected. Likely I2C bus issue:");
        ESP_LOGI(TAG, "- Missing pull-up resistors (add 4.7kΩ)");
        ESP_LOGI(TAG, "- Bus capacitance too high (use shorter wires)");
        ESP_LOGI(TAG, "- Ground loop or noise issue");
    } else {
        ESP_LOGI(TAG, "Found %d device(s) - normal", found);
    }
    
    // 5. If ES8311 was found, initialize it using the WORKING example code pattern
    if (found > 0 && found <= 20) {  // Reasonable number of devices
        ESP_LOGI(TAG, "\nInitializing ES8311 using example code pattern...");
        
        // Create ES8311 handle using the SAME function as the working example
        es8311_handle_t es_handle = es8311_create(I2C_PORT_NUM, 0x18);

    */

void app_main(void) {
    ESP_LOGI(TAG, "=== ESP32-S3 Audio Recorder/Player - OLD I2C DRIVER ===");
    
    // 1. Enable Power Amplifier
    ESP_LOGI(TAG, "Enabling power amplifier...");
    enable_power_amplifier();
    vTaskDelay(pdMS_TO_TICKS(100));
    
    // 2. Initialize I2C using OLD driver (like the example)
    ESP_LOGI(TAG, "Initializing I2C (OLD driver)...");
    
    i2c_config_t i2c_cfg = {
        .mode = I2C_MODE_MASTER,
        .sda_io_num = I2C_SDA_IO,
        .scl_io_num = I2C_SCL_IO,
        .sda_pullup_en = GPIO_PULLUP_ENABLE,
        .scl_pullup_en = GPIO_PULLUP_ENABLE,
        .master.clk_speed = 50000,  // Start slow: 50 kHz
    };
    
    esp_err_t ret = i2c_param_config(I2C_PORT_NUM, &i2c_cfg);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Failed to configure I2C parameters: %s", esp_err_to_name(ret));
        return;
    }
    
    ret = i2c_driver_install(I2C_PORT_NUM, I2C_MODE_MASTER, 0, 0, 0);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Failed to install I2C driver: %s", esp_err_to_name(ret));
        return;
    }
    
    // 3. Check I2C bus status BEFORE scanning
    ESP_LOGI(TAG, "Checking I2C bus...");
    
    // Check SDA/SCL levels
    // gpio_set_direction(I2C_SDA_IO, GPIO_MODE_INPUT);
    // gpio_set_direction(I2C_SCL_IO, GPIO_MODE_INPUT);
    // vTaskDelay(pdMS_TO_TICKS(10));

    // After i2c_driver_install
    gpio_set_direction(I2C_SDA_IO, GPIO_MODE_INPUT);
    gpio_set_direction(I2C_SCL_IO, GPIO_MODE_INPUT);
    vTaskDelay(100);
    printf("SDA: %d, SCL: %d\n", 
        gpio_get_level(I2C_SDA_IO), 
        gpio_get_level(I2C_SCL_IO));
    
    int sda_state = gpio_get_level(I2C_SDA_IO);
    int scl_state = gpio_get_level(I2C_SCL_IO);
    
    ESP_LOGI(TAG, "SDA state: %d, SCL state: %d", sda_state, scl_state);
    if (sda_state == 0 || scl_state == 0) {
        ESP_LOGE(TAG, "I2C bus stuck LOW! Missing pull-up resistors.");
    }
    
    // 4. Simple I2C scan
    ESP_LOGI(TAG, "Scanning I2C bus...");
    
    uint8_t found = 0;
    for (uint8_t addr = 0x08; addr <= 0x77; addr++) {
        i2c_cmd_handle_t cmd = i2c_cmd_link_create();
        i2c_master_start(cmd);
        i2c_master_write_byte(cmd, (addr << 1) | I2C_MASTER_WRITE, true);
        i2c_master_stop(cmd);
        
        ret = i2c_master_cmd_begin(I2C_PORT_NUM, cmd, 50 / portTICK_PERIOD_MS);
        i2c_cmd_link_delete(cmd);
        
        if (ret == ESP_OK) {
            ESP_LOGI(TAG, "Found device at: 0x%02X", addr);
            found++;
            
            // Try to identify ES8311
            if (addr == 0x18 || addr == 0x19) {
                uint8_t reg_value;
                i2c_cmd_handle_t cmd2 = i2c_cmd_link_create();
                i2c_master_start(cmd2);
                i2c_master_write_byte(cmd2, (addr << 1) | I2C_MASTER_WRITE, true);
                i2c_master_write_byte(cmd2, 0xFD, true);  // CHIP ID1 register
                i2c_master_start(cmd2);  // Repeated start
                i2c_master_write_byte(cmd2, (addr << 1) | I2C_MASTER_READ, true);
                i2c_master_read_byte(cmd2, &reg_value, I2C_MASTER_NACK);
                i2c_master_stop(cmd2);
                
                ret = i2c_master_cmd_begin(I2C_PORT_NUM, cmd2, 100 / portTICK_PERIOD_MS);
                i2c_cmd_link_delete(cmd2);
                
                if (ret == ESP_OK) {
                    ESP_LOGI(TAG, "  -> ES8311 Chip ID1: 0x%02X", reg_value);
                }
            }
        }
    }
    
    ESP_LOGI(TAG, "Found %d I2C device(s)", found);
    
    if (found == 0) {
        ESP_LOGE(TAG, "No I2C devices found!");
        ESP_LOGI(TAG, "\nTroubleshooting:");
        ESP_LOGI(TAG, "1. Add 4.7kΩ pull-up resistors from SDA/SCL to 3.3V");
        ESP_LOGI(TAG, "2. Check wiring: SDA->GPIO%d, SCL->GPIO%d", I2C_SDA_IO, I2C_SCL_IO);
        ESP_LOGI(TAG, "3. Verify ES8311 has 3.3V power");
        return;
    }
    
    if (found > 20) {
        ESP_LOGW(TAG, "Too many devices (%d) - bus likely floating", found);
    }
    
    // 5. Initialize ES8311 using the OLD driver functions
    ESP_LOGI(TAG, "\nInitializing ES8311...");
    
    // Use the exact same pattern as the working example
    es8311_handle_t es_handle = es8311_create(I2C_PORT_NUM, 0x18);
    if (es_handle == NULL) {
        ESP_LOGE(TAG, "Failed to create ES8311 handle");
        return;
    }
    
    // Use the exact same configuration as the example
    const es8311_clock_config_t es_clk = {
        .mclk_inverted = false,
        .sclk_inverted = false,
        .mclk_from_mclk_pin = true,
        .mclk_frequency = 12288000,  // 48kHz * 256 = 12.288 MHz
        .sample_frequency = 48000
    };
    
    ret = es8311_init(es_handle, &es_clk, ES8311_RESOLUTION_16, ES8311_RESOLUTION_16);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "ES8311 init failed: %s", esp_err_to_name(ret));
        return;
    }
    
    // Set volume (0-100)
    es8311_voice_volume_set(es_handle, 60, NULL);
    
    // Configure microphone (analog)
    es8311_microphone_config(es_handle, false);
    
    // Set microphone gain
    es8311_microphone_gain_set(es_handle, ES8311_MIC_GAIN_30DB);
    
    ESP_LOGI(TAG, "ES8311 initialized successfully!");
    
    // 6. Initialize I2S
    ESP_LOGI(TAG, "\nInitializing I2S...");
    if (init_i2s_driver() != ESP_OK) {
        ESP_LOGE(TAG, "I2S init failed");
        return;
    }
    
    // 7. Initialize buttons
    ESP_LOGI(TAG, "\nInitializing buttons...");
    if (init_buttons() != ESP_OK) {
        ESP_LOGE(TAG, "Failed to initialize buttons");
        return;
    }
    
    // 8. Play a test beep to confirm audio works
    ESP_LOGI(TAG, "\nPlaying test beep...");
    xTaskCreate(beep_task, "beep_task", 2048, NULL, 5, NULL);
    vTaskDelay(pdMS_TO_TICKS(1500));  // Wait for beep to finish
    
    ESP_LOGI(TAG, "\n=== System Ready ===");
    ESP_LOGI(TAG, "Press buttons to control:");
    ESP_LOGI(TAG, "  - GPIO%d: Record (starts with beep)", BUTTON_REC_GPIO);
    ESP_LOGI(TAG, "  - GPIO%d: Playback", BUTTON_PLAY_GPIO);
    
    // Main event loop
    button_event_t evt;
    while (1) {
        if (xQueueReceive(g_button_event_queue, &evt, portMAX_DELAY)) {
            switch (evt) {
                case BUTTON_REC_EVENT:
                    ESP_LOGI(TAG, "Record button pressed");
                    if (!g_is_recording) {
                        xTaskCreate(beep_task, "beep_start", 2048, NULL, 5, NULL);
                        vTaskDelay(pdMS_TO_TICKS(1100));
                        xTaskCreate(record_audio_task, "record", 4096, NULL, 6, NULL);
                    }
                    break;
                    
                case BUTTON_PLAY_EVENT:
                    ESP_LOGI(TAG, "Playback button pressed");
                    xTaskCreate(playback_audio_task, "playback", 4096, NULL, 5, NULL);
                    break;
            }
        }
    }
}
// Initialize ES8311 device on the I2C bus
static esp_err_t init_es8311_device(void) {
    ESP_LOGI(TAG, "Initializing ES8311 device on I2C bus...");
    
    i2c_device_config_t dev_cfg = {
        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
        .device_address = ES8311_I2C_ADDR,
        .scl_speed_hz = 50000,  // Start with 50 kHz
        .scl_wait_us = 10000,   // 10 ms wait time
    };
    
    esp_err_t ret = i2c_master_bus_add_device(i2c_bus_handle, &dev_cfg, &es8311_dev_handle);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Failed to add ES8311 device to I2C bus: %s", esp_err_to_name(ret));
        return ret;
    }
    
    // Test communication
    uint8_t chip_id = 0;
    ret = es8311_read_reg_new(0xFD, &chip_id); // Read CHIP ID1
    if (ret == ESP_OK) {
        ESP_LOGI(TAG, "ES8311 detected! Chip ID1: 0x%02x", chip_id);
        return ESP_OK;
    }
    
    ESP_LOGE(TAG, "ES8311 not responding");
    return ret;
}

// init_es8311_codec() - new
static esp_err_t init_es8311_codec(void) {
    ESP_LOGI(TAG, "Initializing ES8311 codec...");
    
    // Initialize ES8311 device on I2C bus
    esp_err_t ret = init_es8311_device();
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Failed to initialize ES8311 device");
        return ret;
    }
    
    // Note: We can't use the original es8311_create() because it uses legacy I2C
    // Instead, we'll directly configure ES8311 using our new I2C functions
    
    // Configure ES8311 registers manually (simplified example)
    ESP_LOGI(TAG, "Configuring ES8311 registers...");
    
    // Reset ES8311
    es8311_write_reg_new(0x00, 0x1F); // Reset
    vTaskDelay(pdMS_TO_TICKS(20));
    es8311_write_reg_new(0x00, 0x00);
    es8311_write_reg_new(0x00, 0x80); // Power-on
    
    // Basic configuration
    es8311_write_reg_new(0x0D, 0x01); // Power up analog
    es8311_write_reg_new(0x0E, 0x02); // Enable PGA and ADC
    es8311_write_reg_new(0x12, 0x00); // Power-up DAC
    es8311_write_reg_new(0x13, 0x10); // Enable HP drive
    
    // Set volume
    es8311_write_reg_new(0x32, 0x80); // Volume ~50%
    
    ESP_LOGI(TAG, "ES8311 basic configuration complete");
    return ESP_OK;
}

// ============================
// HELPER: Generate a sine wave beep
// ============================

// Mono
/*
static void generate_beep(int16_t *buffer, size_t num_samples, uint32_t freq, uint32_t sample_rate) {
    for (size_t i = 0; i < num_samples; i++) {
        buffer[i] = (int16_t)(30000.0 * sin(2 * M_PI * freq * i / sample_rate)); // 30k amplitude
    }
}
*/
// Stereo
static void generate_beep(int16_t *buffer, size_t num_samples, uint32_t freq, uint32_t sample_rate) {
    // Generate stereo beep (left and right channels)
    for (size_t i = 0; i < num_samples; i += 2) {
        int16_t sample = (int16_t)(15000.0 * sin(2 * M_PI * freq * (i/2) / sample_rate));
        buffer[i] = sample;     // Left channel
        buffer[i+1] = sample;   // Right channel (same for mono beep)
    }
}

// ============================
// HELPER: Calculate RMS of audio samples
// ============================
static float calculate_rms(int16_t *samples, size_t count) {
    int64_t sum = 0;
    for (size_t i = 0; i < count; i++) {
        sum += (int64_t)samples[i] * samples[i];
    }
    return sqrtf((float)sum / count);
}

// ============================
// TASK: Play a beep (1000 Hz, 1 sec)
// ============================

// Mono
/*
static void beep_task(void *pvParameters) {

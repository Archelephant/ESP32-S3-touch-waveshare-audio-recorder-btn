    free(beep_buffer);
    ESP_LOGI(TAG, "Beep finished.");
    vTaskDelete(NULL);
}
*/

// Stereo
static void beep_task(void *pvParameters) {
    size_t beep_samples = (SAMPLE_RATE * BEEP_DURATION_MS / 1000) * 2; // Stereo
    int16_t *beep_buffer = malloc(beep_samples * sizeof(int16_t));
    if (beep_buffer == NULL) {
        ESP_LOGE(TAG, "Failed to allocate beep buffer");
        vTaskDelete(NULL);
        return;
    }

    generate_beep(beep_buffer, beep_samples, BEEP_FREQ, SAMPLE_RATE);
    ESP_LOGI(TAG, "Playing beep (%d Hz, %d ms)...", BEEP_FREQ, BEEP_DURATION_MS);

    size_t bytes_written = 0;
    esp_err_t ret = i2s_channel_write(i2s_tx_chan, beep_buffer, 
                                      beep_samples * sizeof(int16_t), 
                                      &bytes_written, portMAX_DELAY);
    
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "Beep playback failed: %s", esp_err_to_name(ret));
    } else {
        ESP_LOGI(TAG, "Beep finished, wrote %d bytes", bytes_written);
    }
    
    free(beep_buffer);
    vTaskDelete(NULL);
}

// ============================
// TASK: Record audio until silence
// ============================
static void record_audio_task(void *pvParameters) {
    int16_t read_buffer[REC_BUFFER_SIZE];
    g_recorded_samples = 0;
    g_is_recording = true;
    uint32_t silence_start_time = 0;
    bool silence_detected = false;

    ESP_LOGI(TAG, "Recording started... Speak into the microphone.");

    while (g_is_recording && g_recorded_samples < SAMPLES_TO_REC) {
        size_t bytes_read = 0;
        i2s_channel_read(i2s_rx_chan, read_buffer, sizeof(read_buffer), &bytes_read, pdMS_TO_TICKS(100));
        size_t samples_read = bytes_read / sizeof(int16_t);

        if (samples_read > 0) {
            float rms = calculate_rms(read_buffer, samples_read);

            if (rms < SILENCE_THRESHOLD) {
                if (!silence_detected) {
                    silence_detected = true;
                    silence_start_time = xTaskGetTickCount() * portTICK_PERIOD_MS; // FIXED LINE
                    ESP_LOGI(TAG, "Silence detected, starting timer...");
                } else if ((xTaskGetTickCount() * portTICK_PERIOD_MS - silence_start_time) >= SILENCE_DURATION_MS) {
                    ESP_LOGI(TAG, "Silence duration exceeded. Stopping recording.");
                    g_is_recording = false;
                    break;
                }
            } else {
                silence_detected = false;
            }

            memcpy(&g_audio_buffer[g_recorded_samples], read_buffer, samples_read * sizeof(int16_t));
            g_recorded_samples += samples_read;
            ESP_LOGI(TAG, "Recorded: %"PRIu32" samples (%.1f s)",
                     g_recorded_samples, (float)g_recorded_samples / SAMPLE_RATE);
        }
    }
    
    g_is_recording = false;
    g_audio_ready = (g_recorded_samples > SAMPLE_RATE);
    ESP_LOGI(TAG, "Recording stopped. Total samples: %"PRIu32". Audio ready: %s",
             g_recorded_samples, g_audio_ready ? "YES" : "NO");
    vTaskDelete(NULL);
}

// ============================
// TASK: Playback recorded audio or beeps
// ============================
static void playback_audio_task(void *pvParameters) {
    if (!g_audio_ready || g_recorded_samples == 0) {
        ESP_LOGW(TAG, "No valid audio recorded. Playing two beeps instead.");
        // Play first beep
        beep_task(NULL);
        vTaskDelay(pdMS_TO_TICKS(100)); // Short gap
        // Play second beep
        beep_task(NULL);
    } else {
        ESP_LOGI(TAG, "Playing back recorded audio (%"PRIu32" samples)...", g_recorded_samples);
        // Use I2S write directly
        size_t bytes_written = 0;
        i2s_channel_write(i2s_tx_chan, g_audio_buffer, 
                         g_recorded_samples * sizeof(int16_t), 
                         &bytes_written, portMAX_DELAY);
        ESP_LOGI(TAG, "Playback finished.");
    }
    vTaskDelete(NULL);
}

// ============================
// PSRAM Availability check
// ============================

static void check_psram_status(void) {
    ESP_LOGI(TAG, "Checking memory configuration...");
    
    // Check total heap
    ESP_LOGI(TAG, "Total heap: %d bytes", esp_get_free_heap_size());
    
    // Check largest free block
    ESP_LOGI(TAG, "Largest free block: %d bytes", heap_caps_get_largest_free_block(MALLOC_CAP_DEFAULT));
    
    // Check if PSRAM is available
    if (heap_caps_get_free_size(MALLOC_CAP_SPIRAM) > 0) {
        ESP_LOGI(TAG, "PSRAM is available: %d bytes free", heap_caps_get_free_size(MALLOC_CAP_SPIRAM));
    } else {
        ESP_LOGE(TAG, "PSRAM is NOT available or not initialized!");
    }
    
    // Test PSRAM allocation
    void *test_psram = heap_caps_malloc(1024, MALLOC_CAP_SPIRAM);
    if (test_psram) {
        ESP_LOGI(TAG, "PSRAM test allocation successful");
        free(test_psram);
    } else {
        ESP_LOGE(TAG, "PSRAM test allocation FAILED");
    }
}

// Update your app_main() cleanup
void cleanup_resources(void) {
    if (es_handle != NULL) {
        es8311_delete_new_i2c(es_handle);
        es_handle = NULL;
    }
    if (i2c_bus_handle != NULL) {
        i2c_del_master_bus(i2c_bus_handle);
        i2c_bus_handle = NULL;
    }
}

